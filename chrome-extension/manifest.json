{
  "manifest_version": 3,
  "name": "Colab MCP Runtime Companion",
  "version": "0.2.0",
  "description": "Optional runtime, file transfer, and tab controls for your local Colab MCP server.",
  "minimum_chrome_version": "111",
  "permissions": ["scripting"],
  "host_permissions": [
    "https://colab.research.google.com/*",
    "https://colab.google.com/*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": [
        "https://colab.research.google.com/*",
        "https://colab.google.com/*"
      ],
      "js": ["content.js", "files.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://colab.research.google.com/*",
        "https://colab.google.com/*"
      ],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ]
}
