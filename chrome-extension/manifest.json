{
  "manifest_version": 3,
  "name": "Colab MCP Runtime Companion",
  "version": "0.1.0",
  "description": "Optional runtime controls for your local Colab MCP server.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://colab.research.google.com/*",
        "https://colab.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
